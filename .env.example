# Which provider to use: ollama | openai | openrouter | azure
MODEL_PROVIDER=ollama

OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434

OPENAI_API_KEY=
OPENAI_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Used by OpenRouter when OPENROUTER_MODEL is overloaded or rate limited (leave empty to disable)
OPENROUTER_FALLBACK_MODEL=openrouter/free

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Optional: underlying model name (e.g. gpt-4o) if it differs from the deployment name
AZURE_OPENAI_MODEL=
AZURE_OPENAI_API_VERSION=
